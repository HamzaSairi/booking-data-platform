# Postgres (source OLTP)
POSTGRES_USER=booking
POSTGRES_PASSWORD=change_me
POSTGRES_DB=booking_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# GCP / BigQuery (sprint 2)
# Obligatoire : identifiant du projet GCP.
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/chemin/absolu/hors/du/depot/booking-sa.json
BQ_LOCATION=EU
BQ_DATASET_RAW=raw_booking
BQ_DATASET_STAGING=staging_booking
BQ_DATASET_MARTS=marts_booking
# Plafond d'octets factures par requete (10 Gio).
BQ_MAX_BYTES_BILLED=10737418240

# Airflow (sprint 3)
# FERNET_KEY : chiffre les connexions stockees en base. A generer,
# jamais a partager. Voir README, section « Lancer le projet ».
FERNET_KEY=
# AIRFLOW_UID : doit valoir ton UID hote, sinon les fichiers ecrits
# dans data/ et airflow/logs/ sont inaccessibles a l'un des deux cotes.
AIRFLOW_UID=1000

